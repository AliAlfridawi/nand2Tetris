/**
 * 16-bit adder: Adds two 16-bit two's complement values.
 * The most significant carry bit is ignored.
 */
CHIP Add16 {
    IN a[16], b[16];
    OUT out[16];

    PARTS:
    //// Replace this comment with your code.
    FullAdder(a=a[0] , b=b[0] , c=false , sum=out[0] , carry=cur);
    FullAdder(a=a[1] , b=b[1] , c=cur , sum=out[1] , carry=cur1);
    FullAdder(a=a[2] , b=b[2] , c=cur1 , sum=out[2] , carry=cur2);
    FullAdder(a=a[3] , b=b[3] , c=cur2 , sum=out[3] , carry=cur3);
    FullAdder(a=a[4] , b=b[4] , c=cur3 , sum=out[4] , carry=cur4);
    FullAdder(a=a[5] , b=b[5] , c=cur4 , sum=out[5] , carry=cur5);
    FullAdder(a=a[6] , b=b[6] , c=cur5 , sum=out[6] , carry=cur6);
    FullAdder(a=a[7] , b=b[7] , c=cur6 , sum=out[7] , carry=cur7);
    FullAdder(a=a[8] , b=b[8] , c=cur7 , sum=out[8] , carry=cur8);
    FullAdder(a=a[9] , b=b[9] , c=cur8 , sum=out[9] , carry=cur9);
    FullAdder(a=a[10] , b=b[10] , c=cur9 , sum=out[10] , carry=cur10);
    FullAdder(a=a[11] , b=b[11] , c=cur10 , sum=out[11] , carry=cur11);
    FullAdder(a=a[12] , b=b[12] , c=cur11 , sum=out[12] , carry=cur12);
    FullAdder(a=a[13] , b=b[13] , c=cur12 , sum=out[13] , carry=cur13);
    FullAdder(a=a[14] , b=b[14] , c=cur13 , sum=out[14] , carry=cur14);
    FullAdder(a=a[15] , b=b[15] , c=cur14 , sum=out[15] , carry=null);

}